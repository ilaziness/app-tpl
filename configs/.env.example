# Sensitive configuration only — passwords, API keys, and secrets.
# These values override the corresponding fields in YAML via Viper BindEnv.
#
# Do NOT set APP_ENV here. Use --env / -e or the process environment APP_ENV.
#
# Dotenv load order (godotenv does not override variables already in the process
# environment; among dotenv files, earlier load wins):
#   1. .env.{env}            (when --env / APP_ENV is set)
#   2. ./configs/.env.{env}
#   3. .env
#   4. ./configs/.env
#
# Copy to configs/.env (gitignored) for local use:
#   cp configs/.env.example configs/.env

# Database
DATABASE_PASSWORD=your_database_password_here

# Redis
REDIS_PASSWORD=your_redis_password_here

# JWT (required in production; at least 32 bytes)
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars

# Internal service-to-service HTTP key (optional)
HTTP_INTERNAL_SERVICE_KEY=

# Object storage (optional; when object_storage.enabled)
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
